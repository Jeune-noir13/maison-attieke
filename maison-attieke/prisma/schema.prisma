generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  nom            String
  prenoms        String
  email          String    @unique
  telephone      String?
  dateNaissance  DateTime?
  lieuHabitation String?
  motDePasse     String
  sexe           String?   @default("")
  points         Int       @default(0)
  image          String?
  role           String    @default("CLIENT")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  commandes Commande[]
  adresses  Adresse[]
  offres    Offre[]
  sessions  Session[]
  accounts  Account[]
  avis      Avis[]
  favoris   Favori[]
  conversations     ChatConversation[]
  contactMessages   ContactMessage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Admin {
  id         String   @id @default(cuid())
  nom        String
  email      String   @unique
  motDePasse String
  createdAt  DateTime @default(now())
}

model Livreur {
  id          String   @id @default(cuid())
  livreurId   String   @unique
  nom         String
  prenom      String
  telephone   String
  motDePasse  String
  statut      String   @default("DISPONIBLE")
  enLigne     Boolean  @default(false)
  createdAt   DateTime @default(now())

  commandes Commande[]
  position  LivreurPosition?
}

model LivreurPosition {
  id        String   @id @default(cuid())
  livreurId String   @unique
  lat       Float
  lng       Float
  updatedAt DateTime @updatedAt

  livreur Livreur @relation(fields: [livreurId], references: [id])
}

model MenuItem {
  id          String   @id @default(cuid())
  nom         String
  description String
  prix        Int
  image       String?
  categorie   String
  disponible  Boolean  @default(true)
  populaire   Boolean  @default(false)
  note        Float    @default(4.5)
  nombreAvis  Int      @default(0)
  createdAt   DateTime @default(now())

  lignesCommande LigneCommande[]
  lignesOffre    LigneOffre[]
  favoris        Favori[]
}

model Commande {
  id         String   @id @default(cuid())
  numero     String   @unique
  userId          String
  livreurId       String?
  promotionId     String?
  statut          String   @default("EN_ATTENTE")
  sousTotal       Int
  livraison       Int      @default(500)
  discountApplied Int      @default(0)
  pointsUtilises  Int      @default(0)
  total           Int
  adresse         String
  clientLat       Float?
  clientLng       Float?
  paiement        String   @default("LIVRAISON")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id])
  livreur   Livreur?        @relation(fields: [livreurId], references: [id])
  promotion Promotion?      @relation(fields: [promotionId], references: [id])
  lignes    LigneCommande[]
  offre     Offre?
  avis      Avis?
}

model LigneCommande {
  id           String @id @default(cuid())
  commandeId   String
  menuItemId   String
  quantite     Int    @default(1)
  prixUnitaire Int
  prixTotal    Int

  commande Commande @relation(fields: [commandeId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model Offre {
  id              String   @id @default(cuid())
  commandeId      String   @unique
  userId          String
  montantOriginal Int
  montantOffert   Int
  montantAccepte  Int?
  statut          String   @default("EN_ATTENTE")
  commentaire     String?
  createdAt       DateTime @default(now())

  commande Commande   @relation(fields: [commandeId], references: [id])
  user     User       @relation(fields: [userId], references: [id])
  lignes   LigneOffre[]
}

model LigneOffre {
  id         String @id @default(cuid())
  offreId    String
  menuItemId String
  quantite   Int

  offre    Offre    @relation(fields: [offreId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model Avis {
  id           String   @id @default(cuid())
  commandeId   String   @unique
  userId       String
  livreurId    String?
  noteCommande Int      @default(5)
  noteLivreur  Int?
  commentaire  String?
  createdAt    DateTime @default(now())

  commande Commande @relation(fields: [commandeId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

model Adresse {
  id      String  @id @default(cuid())
  userId  String
  label   String
  adresse String
  commune String
  defaut  Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
}

model Favori {
  id         String   @id @default(cuid())
  userId     String
  menuItemId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
}

model SiteSettings {
  id             String   @id @default("main")
  logoText       String   @default("M")
  siteName       String   @default("Maison de l'Attiéké")
  slogan         String   @default("L'attiéké comme vous ne l'avez jamais goûté.")
  telephone      String   @default("+225 07 07 07 07 07")
  adresse        String   @default("Cocody, Abidjan – Côte d'Ivoire")
  email          String   @default("contact@maison-attieke.ci")
  fraisLivraison Int      @default(500)
  ouvertureHeure String   @default("10:00")
  fermetureHeure String   @default("23:00")
  logoUrl           String?
  heroTitle         String   @default("L'ATTIÉKÉ COMME VOUS NE L'AVEZ JAMAIS GOÛTÉ.")
  heroSubtitle      String   @default("Des recettes authentiques, des ingrédients frais.")
  // À propos
  aboutDescription  String   @default("La Maison de l'Attiéké est un restaurant ivoirien passionné par les saveurs authentiques. Nous vous proposons des plats préparés avec des ingrédients frais, livrés directement chez vous.")
  aboutHistoire     String   @default("Fondée à Cocody, notre cuisine s'inspire des recettes traditionnelles transmises de génération en génération. Chaque plat est une invitation au voyage au cœur de la Côte d'Ivoire.")
  facebook          String   @default("")
  instagram         String   @default("")
  whatsapp          String   @default("")
  googleMapsUrl     String   @default("")
  supportTelephone  String  @default("")
  supportWhatsapp   String  @default("")
  chatActif         Boolean @default(true)
  updatedAt         DateTime @updatedAt
}

model Promotion {
  id          String     @id @default(cuid())
  code        String     @unique
  description String
  type        String     @default("PERCENT")
  valeur      Int        @default(10)
  minCommande Int        @default(0)
  maxUses     Int        @default(100)
  usedCount   Int        @default(0)
  actif       Boolean    @default(true)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())

  commandes Commande[]
}

model ContactMessage {
  id        String   @id @default(cuid())
  nom       String
  email     String
  message   String
  reponse   String?
  userId    String?
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}

model ChatConversation {
  id        String    @id @default(cuid())
  sessionId String    @unique
  userId    String?
  statut    String    @default("BOT")
  sujet     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  ChatMsg[]
  user      User?     @relation(fields: [userId], references: [id])
}

model ChatMsg {
  id             String           @id @default(cuid())
  conversationId String
  expediteur     String
  contenu        String
  lu             Boolean          @default(false)
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
}
